# Full set of MorpheusUI variables, including IGNORE_DEBUG_LOGS (not declared in ui-desktop/env.schema.ts).
#
# env.schema.ts is the definition: electron.vite.config.ts injects exactly the
# keys it declares (envsToInject = Object.keys(EnvSchema.properties)), so a
# variable absent from it is read from .env and then discarded. The app reads
# these in three places -- src/main/config/index.ts, orchestrator.config.ts and
# src/main/logger.ts -- so no single reader is the full list.
# Includes known TESTNET and MAINNET Values if/when known
# Currently aligned to MAINNET values

# Chain Configurations
# Enable bypass authentication (set to "true" to bypass authentication)
BYPASS_AUTH=false

# Chain ID for blockchain network (required)
# Ethereum Chain ID (must be a number)
# TESTNET: 84532 (BASE Sepolia), MAINNET: 8453 (BASE)
CHAIN_ID=

# Default currency symbol for sellers (default is "BTC")
DEFAULT_SELLER_CURRENCY=BTC

# Diamond contract address for the chain (required)
# TESTNET: 0xA328196f2438DADA5ab729E39388D86896c27c85 (BASE Sepolia), MAINNET: 0x6aBE1d282f72B474E54527D93b979A4f64d3030a (BASE)
DIAMOND_ADDRESS=0x6aBE1d282f72B474E54527D93b979A4f64d3030a

# Human-readable chain name shown in the UI. Read by
# ui-desktop/src/main/config/index.ts:9 as config.chain.displayName.
# NOTE: an older DISPLAY_NAME variable appears in some .env files; nothing
# reads it. CHAIN_NAME is the one that takes effect.
CHAIN_NAME=Base

# Blockchain explorer URL (required; validated as a plain string, not as a URL --
# env.schema.ts:17 is a bare Type.String() with no format:'uri')
EXPLORER_URL=

# Token contract address for the main token (required)
# TESTNET: 0x5C80Ddd187054E1E4aBBfFCD750498e81d34FfA3 (BASE Sepolia), MAINNET: 0x7431aDa8a591C955a994a21710752EF9b882b8e3 (BASE)
TOKEN_ADDRESS=0x7431aDa8a591C955a994a21710752EF9b882b8e3

# Debug Configurations
# Enable debug mode (set to "true" to enable debug logging, requires IGNORE_DEBUG_LOGS=false)
DEBUG=false
# Ignore debug logs even if DEBUG is enabled (set to "true" to ignore).
# CAVEAT: this is the one variable read by the app (src/main/config/index.ts:17)
# that env.schema.ts does NOT declare. Only declared keys are injected into the
# build, so in a PACKAGED app a value set here is loaded and discarded -- it
# takes effect only when set as a real environment variable at launch. The
# mechanism is verifiable from source; the runtime behaviour has not been tested
# against a build.
IGNORE_DEBUG_LOGS=false

# Verbosity of the DESKTOP APP's own logger, for both the console and the log
# file (ui-desktop/src/main/logger.ts:36-37). One of: error, warn, info,
# verbose, debug, silly. Defaults to warn.
# NOTE: this is NOT the proxy-router's logging. That process has no plain
# LOG_LEVEL -- it has LOG_LEVEL_APP, LOG_LEVEL_ETH_RPC, LOG_LEVEL_STORAGE and
# LOG_LEVEL_TCP, documented in docs/reference/env-proxy-router.mdx. The names
# look alike and control different programs.
LOG_LEVEL=warn

# Enable developer tools in the Electron app (set to "true" to enable)
DEV_TOOLS=false

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# Google Analytics tracking ID (optional)
TRACKING_ID=

# Session Failover Policy Enable (optional) (by default "true")
FAILOVER_ENABLED=
# ---------------------------------------------------------------------------
# Bundled services
#
# MorpheusUI downloads and supervises three child processes -- the proxy-router,
# a llama.cpp server for the local model, and an IPFS daemon. These settings
# control where each is fetched from and which port it listens on. They are read
# by ui-desktop/orchestrator.config.ts, not by src/main/config/index.ts, which is
# why they are absent from older revisions of this file.
# ---------------------------------------------------------------------------

# Where to download the proxy-router binary, per platform. Empty by default:
# a build with no value set has nowhere to fetch the router from, so a
# first-time install cannot start it. Each platform reads only its own key
# (orchestrator.config.ts:10, 132, 156, 181, 205, 250).
SERVICE_PROXY_DOWNLOAD_URL_MAC_ARM64=
SERVICE_PROXY_DOWNLOAD_URL_MAC_X64=
SERVICE_PROXY_DOWNLOAD_URL_LINUX_X64=
SERVICE_PROXY_DOWNLOAD_URL_LINUX_ARM64=
SERVICE_PROXY_DOWNLOAD_URL_WINDOWS_X64=
SERVICE_PROXY_DOWNLOAD_URL_WINDOWS_ARM64=

# Port for the proxy-router's HTTP API. The app passes WEB_ADDRESS as
# 0.0.0.0:${SERVICE_PROXY_API_PORT} and WEB_PUBLIC_URL as
# http://localhost:${SERVICE_PROXY_API_PORT}, as shown in orchestrator.config.ts
# lines 23-24.
SERVICE_PROXY_API_PORT=8082

# Port for the proxy-router's consumer-facing TCP tunnel. Passed to the router
# as PROXY_ADDRESS=0.0.0.0:<this> (orchestrator.config.ts:22). This is the port
# other people's nodes connect to, not the local API above.
SERVICE_PROXY_PORT=3333

# Port for the bundled IPFS (kubo) daemon's API. Used to launch it and passed to
# the proxy-router as IPFS_MULTADDR=/ip4/127.0.0.1/tcp/<this>
# (orchestrator.config.ts:40, 108, 112).
SERVICE_IPFS_API_PORT=5001

# Port for the bundled llama.cpp server that serves the local model. Used as its
# --port, its health probe, and as the local model's apiUrl
# http://localhost:<this>/v1/chat/completions (orchestrator.config.ts:47, 65-76).
SERVICE_AI_API_PORT=3434

# ---------------------------------------------------------------------------
# Passed through to the proxy-router
#
# Set these on MorpheusUI; it forwards them to the proxy-router process it
# starts. Their behaviour is the proxy-router's, and is documented in
# docs/reference/env-proxy-router.mdx.
# ---------------------------------------------------------------------------

# Forwarded unchanged as the router's BLOCKSCOUT_API_URL
# (orchestrator.config.ts:17).
BLOCKSCOUT_API_URL=https://base.blockscout.com/api/v2

# Forwarded to the router under a DIFFERENT name, as ENVIRONMENT
# (orchestrator.config.ts:19). One of: development, production.
NODE_ENV=production
