{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "orchestrator.config.*",
    "src/main/**/*", "src/shared/**/*",
    "src/preload/**/*",
    "env.schema.ts",
    "validator.ts"
  ],
  "exclude": ["src/main/**/*.test.ts"],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"]
  }
}
